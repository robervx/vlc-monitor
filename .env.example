# Ninguna variable es obligatoria para arrancar en local (npm run dev).
# Se van añadiendo a medida que cada spec las requiera — no añadas una
# variable aquí sin que la spec correspondiente la documente.

# Spec 000 — si el endpoint de distritos requiere API key (a confirmar)
# VITE_OPENDATASOFT_API_KEY=

# Spec 001 (futura) — AEMET OpenData
# AEMET_API_KEY=

# Caché — Upstash Redis (free tier)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
