{
  "name": "vlc-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Monitor de datos abiertos de València en tiempo real: movilidad, meteorología, calidad del aire, eventos e incidencias en un único mapa.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "auth:hash": "tsx scripts/auth-hash.ts",
    "marca": "tsx scripts/generar-marca.ts",
    "seed:distritos": "node scripts/seed-distritos.mjs",
    "seed:red-viaria": "tsx scripts/seed-red-viaria.ts",
    "snapshot:trafico-historico": "tsx scripts/snapshot-trafico-historico.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@turf/circle": "^7.4.0",
    "maplibre-gl": "^4.7.1",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.7.0",
    "@types/rbush": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vercel": "^59.10.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.0"
  }
}
